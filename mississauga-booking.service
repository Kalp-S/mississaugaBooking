[Unit]
Description=Active Mississauga Automated Activity Booking Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mississaugaBooking
ExecStart=/usr/bin/python3 /home/pi/mississaugaBooking/topLevel.py "BARCODE_1" "PIN_1"
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
